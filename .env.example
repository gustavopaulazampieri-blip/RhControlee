# Supabase values used by server-side authentication
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Required only by trusted server-side operations. Never expose this value
# with a VITE_ prefix or commit the real key to version control.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase values exposed to the browser by Vite
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional project identifier used by the Lovable/Supabase integration
SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PROJECT_ID=your-project-id
